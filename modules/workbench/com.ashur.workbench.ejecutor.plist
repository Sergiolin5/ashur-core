<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Arranca el ejecutor de Workbench al iniciar sesión en la Mac y lo vuelve a levantar si se cae.
     Cambia RUTA_DEL_REPO y DIRECCION_DEL_CORE antes de copiarlo a ~/Library/LaunchAgents/ (ver README.md).
     La clave de administrador no va aquí: el ejecutor la lee del Llavero. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ashur.workbench.ejecutor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-u</string>
    <string>RUTA_DEL_REPO/modules/workbench/ejecutor.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ASHUR_CORE</key>
    <string>DIRECCION_DEL_CORE</string>
    <key>PATH</key>
    <string>RUTA_DE_LOS_PROGRAMAS:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/tmp/ashur-workbench-ejecutor.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/ashur-workbench-ejecutor.log</string>
</dict>
</plist>
